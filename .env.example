# API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/empleos_pa
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Authentication (configure before enabling auth)
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Commercial flow
# FREE = launch promotion: new requests advance without payment.
# MANUAL = require payment reference and admin review before search.
REQUEST_PAYMENT_MODE=FREE

# Candidate profile
CANDIDATE_VALIDITY_DAYS=45

# Email notifications (provider-neutral HTTPS adapter)
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=
EMAIL_FROM=Empleos.pa

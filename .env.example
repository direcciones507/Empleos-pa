# API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/empleos_pa
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Authentication
# Sessions use opaque random tokens stored hashed in PostgreSQL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Commercial flow
# FREE = launch promotion: new requests advance without payment.
# MANUAL = require payment reference and admin review before search.
REQUEST_PAYMENT_MODE=FREE

# Candidate profile
CANDIDATE_VALIDITY_DAYS=45
# Secret Bearer token for an external hourly scheduler calling POST /v1/system/candidate-lifecycle
LIFECYCLE_CRON_SECRET=

# Email notifications (provider-neutral HTTPS adapter)
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=
EMAIL_FROM=Empleos.pa

# AI candidate analysis (server-side only)
# Structured PostgreSQL filtering remains the first stage. AI adds descriptive analysis only.
# Configure the actual secret separately in the Empleos.pa API runtime; never commit or expose it to Web.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Default model used by the current server implementation. Override only after validating a compatible model.
DEEPSEEK_MODEL=deepseek-chat

# Data lifecycle / retention
# Technical cleanup currently covers expired/revoked sessions and password-reset tokens.
# Business-record deletion periods must not be invented: define them only after the final privacy/legal policy is approved.
# Keep historical delivery snapshots and administrative audit records intact until that policy is finalized.
